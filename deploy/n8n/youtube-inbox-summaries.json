    {
      "id": "af4ab6b6-83f0-4332-acfe-a403ce8e76a0",
      "name": "Not ready",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Health said the service or its LLM is not ready: do nothing this run.\nconst h = $json;\nreturn [{ json: { skipped: true, reason: h.error ? `service unreachable: ${h.error?.message ?? h.error}` : `status=${h.status}, llm.ok=${h.llm?.ok}`, health: h } }];"
      }
    },
    {
      "id": "42a8f97b-f21b-4a7f-a20d-20ea0c64bdab",
      "name": "Known Summaries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -120,
        200
      ],
      "parameters": {
        "url": "={{ $('Config').first().json.baseUrl }}/summaries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
