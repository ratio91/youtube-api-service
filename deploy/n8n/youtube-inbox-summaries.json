        "httpBasicAuth": {
          "id": "TUaQfRSfr3pvaJJL",
          "name": "youtube api service"
        }
      }
    },
    {
      "id": "f39ff07e-5c9c-4345-b7fe-36bd3c2b4b6a",
      "name": "Get Inbox",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        100,
        200
      ],
      "alwaysOutputData": true,
      "parameters": {
        "resource": "playlistItem",
        "operation": "getAll",
        "playlistId": "={{ $('Config').first().json.playlistId }}",
        "returnAll": true,
        "part": [
          "snippet",
          "contentDetails"
        ],
        "options": {}
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "BpOMxRW0lEjvhidB",
          "name": "YouTube account"
        }
      }
    },
    {
      "id": "8f598c40-d412-466a-8a38-5281009bcbb7",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per inbox video that has no summary yet (dedup source = the service's own\n// summary listing, so re-runs are free). Skips deleted/private videos and caps the run.\nconst cfg = $('Config').first().json;\nconst known = new Set(($('Known Summaries').first().json.summaries ?? []).map(s => s.videoId));\nconst seen = new Set();\nconst out = [];\nfor (const it of $input.all().map(i => i.json)) {\n  const videoId = it.contentDetails?.videoId ?? it.snippet?.resourceId?.videoId;\n  if (!videoId || seen.has(videoId)) continue;\n  seen.add(videoId);\n  const title = it.snippet?.title ?? '';\n  if (title === 'Deleted video' || title === 'Private video') continue;\n  if (known.has(videoId)) continue;\n  out.push({ json: { videoId, title, channel: it.snippet?.videoOwnerChannelTitle ?? '' } });\n}\nconst max = Number(cfg.maxPerRun) || 20;\nreturn out.slice(0, max);"
      }
    },
    {
      "id": "24513e6a-48c0-43cf-8762-1f38b8ed21ea",
      "name": "Loop Videos",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        540,
        200
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "d26ef00a-df44-4fbc-9f03-93bc7e4e799e",
      "name": "Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        780,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "={{ $('Config').first().json.baseUrl }}/summary/{{ $json.videoId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 900000
        }
      },
      "credentials": {
        "httpBasicAuth": {
          "id": "TUaQfRSfr3pvaJJL",
          "name": "youtube api service"
        }
      },
      "notes": "One summary can take 1–6 minutes (LLM prefill). The service caches summaries and writes the Obsidian note itself.",
      "notesInFlow": true
    },
    {
      "id": "7b449fb7-a9cb-4af4-a10b-7c0e14f2b0f1",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Map the service's status codes to an action for this video.\n// 200 done · 404 no captions (never retry) · 503 retry next run · anything else failed.\nconst v = $('Loop Videos').item.json;\nconst r = $json;                       // full HTTP response, or { error } if the request itself failed\nconst code = r.statusCode ?? 0;\nconst body = r.body ?? {};\nlet status, note;\nif (r.error) { status = 'retry'; note = String(r.error?.message ?? r.error).slice(0, 200); }\nelse if (code === 200) { status = 'done'; note = body.note?.fileName ? `note: ${body.note.fileName}` : `${body.strategy}, ${Math.round((body.durationMs ?? 0) / 1000)} s`; }\nelse if (code === 404) { status = 'no-captions'; note = body.reason ?? ''; }\nelse if (code === 503 || body.retryable) { status = 'retry'; note = body.reason ?? `http ${code}`; }\nelse { status = 'failed'; note = (body.reason ?? body.error ?? `http ${code}`).toString().slice(0, 200); }\nreturn { json: { videoId: v.videoId, title: v.title, status, code, cached: body.cached ?? null, note } };"
      }
    },
    {
      "id": "74b4a6f2-a7d0-4e19-8457-4f9f807b2a16",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const counts = {};\nfor (const i of $input.all()) counts[i.json.status] = (counts[i.json.status] ?? 0) + 1;\nconst attention = $input.all().filter(i => i.json.status === 'failed' || i.json.status === 'retry')\n  .map(i => ({ videoId: i.json.videoId, title: i.json.title, status: i.json.status, note: i.json.note }));\nreturn [{ json: { processed: $input.all().length, counts, attention } }];"
      }
    }
  ],
