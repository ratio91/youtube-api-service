              "id": "f89a660a-9891-5fa5-bb6c-2296ef6f11c3",
              "leftValue": "={{ String(['done', 'no_captions', 'failed'].includes($json.status)) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
