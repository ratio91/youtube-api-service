    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.dataTableId }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "summaryStatus",
              "condition": "neq",
              "keyValue": "done"
            },
            {
              "keyName": "summaryStatus",
              "condition": "neq",
              "keyValue": "no_captions"
            },
            {
              "keyName": "summaryStatus",
              "condition": "neq",
              "keyValue": "failed"
            }
          ]
        },
        "returnAll": true
      },
      "id": "3fdceb6c-c6f9-5963-8ad0-027708c20788",
      "name": "Get Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -100,
        200
      ],
      "alwaysOutputData": true,
      "notes": "Rows without a final summaryStatus (neq also matches unset columns). Fails loudly if the summaryStatus column is missing.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Rows whose video already has a summary in the service but no summaryStatus yet\n// (made by hand or by an earlier workflow): mark them done once.\nconst known = new Set(($('Known Summaries').first().json.summaries ?? []).map(s => s.videoId));\nconst seen = new Set();\nconst out = [];\nfor (const r of $input.all().map(i => i.json)) {\n  if (!r.videoId || seen.has(r.videoId) || r.summaryStatus) continue;\n  seen.add(r.videoId);\n  if (known.has(r.videoId)) out.push({ json: { videoId: r.videoId } });\n}\nreturn out;\n"
      },
      "id": "6dbf4a31-0753-5404-902b-1e15238bef9c",
      "name": "Already Summarised",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.dataTableId }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "videoId",
              "condition": "eq",
              "keyValue": "={{ $json.videoId }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "summaryStatus": "done",
            "summaryNote": "={{ 'summary existed ' + $now.toISODate() }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "summaryStatus",
              "displayName": "summaryStatus",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "summaryNote",
              "displayName": "summaryNote",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            }
          ]
        },
        "options": {}
      },
      "id": "e16f6650-248c-5382-8274-a7454d95d15d",
      "name": "Mark Done",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        340,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per table row still to summarise: no final summaryStatus (null and '' alike),\n// no summary in the service yet, not a dead video. Newest rows first, capped by maxPerRun.\n// The deadline is computed once: today's stopAt, or now + maxRunMinutes for a run started\n// after stopAt (manual daytime runs).\nconst cfg = $('Config').first().json;\nconst known = new Set(($('Known Summaries').first().json.summaries ?? []).map(s => s.videoId));\nconst [h, m] = String(cfg.stopAt ?? '06:30').split(':').map(Number);\nlet deadline = $now.set({ hour: h, minute: m, second: 0, millisecond: 0 });\nif (deadline <= $now) deadline = $now.plus({ minutes: Number(cfg.maxRunMinutes) || 330 });\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r.videoId && !r.summaryStatus && !known.has(r.videoId) && r.targetName !== 'dead')\n  .sort((a, b) => String(b.createdAt ?? '').localeCompare(String(a.createdAt ?? '')));\nconst seen = new Set();\nconst out = [];\nfor (const r of rows) {\n  if (seen.has(r.videoId)) continue;\n  seen.add(r.videoId);\n  out.push({ json: { videoId: r.videoId, title: r.title ?? '', deadline: deadline.toISO(), deadlineMs: deadline.toMillis() } });\n}\nreturn out.slice(0, Number(cfg.maxPerRun) || 150);\n"
      },
      "id": "726f24ca-2ca3-5fd5-9161-fe48924266ac",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        200
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "2832b10c-1a33-52fd-9a69-cc15eb9ca5fc",
      "name": "Loop Videos",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        340,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "00b8737e-8766-5cf5-aac5-23ecc9fb6415",
              "leftValue": "={{ String($now.toMillis() < $json.deadlineMs) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "43ba55ab-b538-5ed3-a8de-ea3b0437c513",
      "name": "In Time?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Past the deadline: pass the video through without calling the service; next night.\nconst v = $('Loop Videos').first().json;\nreturn [{ json: { videoId: v.videoId, title: v.title, status: 'deferred', code: null, note: `not started, deadline ${v.deadline}` } }];\n"
      },
      "id": "a272f8f0-95a3-5bc1-81e5-a68477af4bb9",
      "name": "Deferred",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        500
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.baseUrl }}/summary/{{ $('Loop Videos').first().json.videoId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 900000
        }
      },
      "id": "02d82be2-7257-553b-8e5f-ed45241aec53",
      "name": "Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        780,
        200
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpBasicAuth": {
          "id": "TUaQfRSfr3pvaJJL",
          "name": "youtube api service"
        }
      },
      "notes": "One summary can take 1–6 minutes, long chunked videos up to 15. The service caches it and writes the Obsidian note itself.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Map the service's answer to a table status (docs/decisions.md 2026-09-23):\n// 200 done · 404 no_captions · 400/500 failed — all three final, cleared by hand;\n// 503, other codes (e.g. 401) or a failed request: retry next night, status stays empty.\nconst v = $('Loop Videos').first().json;\nconst r = $input.first().json;          // full HTTP response, or { error } if the request itself failed\nconst code = r.statusCode ?? 0;\nconst body = r.body ?? {};\nconst reason = (x) => String(x ?? '').slice(0, 300);\nconst day = $now.toISODate();\nlet status, note;\nif (r.error) { status = 'retry'; note = reason(r.error?.message ?? r.error); }\nelse if (code === 200) { status = 'done'; note = body.note?.fileName ? `note: ${body.note.fileName}` : `${body.strategy}, ${Math.round((body.durationMs ?? 0) / 1000)} s`; }\nelse if (code === 404) { status = 'no_captions'; note = reason(`${body.code ?? 404}: ${body.reason ?? ''}`); }\nelse if (code === 400 || code === 500) { status = 'failed'; note = reason(`${body.code ?? code}: ${body.reason ?? body.error ?? ''}`); }\nelse { status = 'retry'; note = reason(`${body.code ?? `http ${code}`}: ${body.reason ?? body.error ?? ''}`); }\nreturn [{ json: { videoId: v.videoId, title: v.title, status, code, cached: body.cached ?? null, note: `${day} ${note}` } }];\n"
      },
      "id": "06b0676a-e549-504c-b3a0-65af127580d6",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
