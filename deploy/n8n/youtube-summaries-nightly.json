    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Hand this video's outcome back to the loop (the update node outputs table rows, or\n// nothing when no row matched).\nreturn [{ json: $('Classify').first().json }];\n"
      },
      "id": "09b76264-b3b9-5033-b14c-d982f0ec5ca7",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst counts = {};\nfor (const i of items) counts[i.status] = (counts[i.status] ?? 0) + 1;\nconst attention = items.filter(i => i.status === 'failed' || i.status === 'retry')\n  .map(i => ({ videoId: i.videoId, title: i.title, status: i.status, note: i.note }));\nreturn [{ json: { processed: items.length, counts, attention } }];\n"
      },
      "id": "ae118624-86ba-5a33-9679-aa858786cf28",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ]
    }
