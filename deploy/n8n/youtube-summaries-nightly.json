              "type": "string",
              "readOnly": false,
              "removed": false
            }
          ]
        },
        "options": {}
      },
      "id": "e16f6650-248c-5382-8274-a7454d95d15d",
      "name": "Mark Done",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        560,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
