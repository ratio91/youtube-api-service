    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 200 with a valid answer → write the four suggest* columns (\"none\" = empty playlistId).\n// \"invalid model output\", 409 (no summary), 503 or a failed request → write nothing;\n// the row keeps an empty suggestedName and is tried again next run.\nconst v = $('Loop Videos').first().json;\nconst r = $input.first().json;\nconst code = r.statusCode ?? 0;\nconst body = r.body ?? {};\nconst ok = !r.error && code === 200 && body.reason !== 'invalid model output';\nreturn [{ json: {\n  videoId: v.videoId,\n  ok,\n  suggestedPlaylistId: ok ? (body.playlistId ?? '') : null,\n  suggestedName: ok ? (body.name ?? 'none') : null,\n  suggestConfidence: ok ? body.confidence : null,\n  suggestReason: ok ? String(body.reason ?? '').slice(0, 200) : null,\n  suggestion: ok ? `${body.name ?? 'none'} (${body.confidence})` : `retry: ${r.error ? String(r.error?.message ?? r.error).slice(0, 120) : `${body.code ?? `http ${code}`} ${body.reason ?? ''}`.trim()}`,\n} }];\n"
      },
