    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Hand this video's outcome back to the loop (the update node outputs table rows, or\n// nothing when no row matched).\nreturn [{ json: $('Classify').first().json }];\n"
      },
      "id": "09b76264-b3b9-5033-b14c-d982f0ec5ca7",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst counts = {};\nfor (const i of items) counts[i.status] = (counts[i.status] ?? 0) + 1;\nconst suggestions = {};\nfor (const i of items.filter(i => i.suggestion)) {\n  const k = i.suggestion.startsWith('retry') ? 'retry' : i.suggestion.replace(/^.*\\((\\w+)\\)$/, '$1');\n  suggestions[k] = (suggestions[k] ?? 0) + 1;\n}\nconst attention = items.filter(i => i.status === 'failed' || i.status === 'retry' || i.suggestion?.startsWith('retry'))\n  .map(i => ({ videoId: i.videoId, title: i.title, status: i.status, note: i.note, suggestion: i.suggestion }));\nreturn [{ json: { processed: items.length, counts, suggestions, attention } }];\n"
      },
