    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Two kinds of work, one item each:\n//  - \"classify\": the video already has a summary (summaryStatus done, or a summary in the\n//    service) but no suggestion yet → only POST /classify (cheap, summary is cached).\n//  - \"summarize\": no final summaryStatus, no summary yet → GET /summary, then /classify.\n// Dead videos are skipped. Classify items first (seconds each), then summaries newest\n// first, capped by maxPerRun. The deadline is computed once: today's stopAt, or\n// now + maxRunMinutes for a run started after stopAt (manual daytime runs).\nconst cfg = $('Config').first().json;\nconst known = new Set(($('Known Summaries').first().json.summaries ?? []).map(s => s.videoId));\nconst hasTaxonomy = $('Get Playlists').all().some(i => i.json.playlistId);\nconst [h, m] = String(cfg.stopAt ?? '06:30').split(':').map(Number);\nlet deadline = $now.set({ hour: h, minute: m, second: 0, millisecond: 0 });\nif (deadline <= $now) deadline = $now.plus({ minutes: Number(cfg.maxRunMinutes) || 330 });\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r.videoId && r.targetName !== 'dead')\n  .sort((a, b) => String(b.createdAt ?? '').localeCompare(String(a.createdAt ?? '')));\nconst seen = new Set();\nconst classify = [];\nconst summarize = [];\nfor (const r of rows) {\n  if (seen.has(r.videoId)) continue;\n  seen.add(r.videoId);\n  const base = { videoId: r.videoId, title: r.title ?? '', deadline: deadline.toISO(), deadlineMs: deadline.toMillis() };\n  const summarised = r.summaryStatus === 'done' || known.has(r.videoId);\n  if (summarised) { if (hasTaxonomy && !r.suggestedName) classify.push({ json: { ...base, mode: 'classify' } }); }\n  else if (!r.summaryStatus) summarize.push({ json: { ...base, mode: 'summarize' } });\n}\nreturn [...classify, ...summarize.slice(0, Number(cfg.maxPerRun) || 150)];\n"
      },
