      "id": "5c897e98-8814-5ad4-84e6-2ea13c925cd0",
      "name": "Known Summaries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -320,
        200
      ],
      "credentials": {
