# ---- always required -------------------------------------------------------
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ---- OAuth / playlist routes (optional) -------------------------------------
# Leave all three empty to run in transcript-only mode (OAuth and playlist
# routes answer 503). Set all three to enable them; a partial set fails startup.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
# Optional: playlist used by GET /videos when no ?playlistId= is given
DEFAULT_PLAYLIST_ID=

# ---- transcripts (yt-dlp) ---------------------------------------------------
# Pause between videos in POST /batch-transcripts (avoids bot checks)
TRANSCRIPT_BATCH_DELAY_MS=3000
# Max videoIds per batch request
TRANSCRIPT_BATCH_MAX=50
# Attempts per video for rate-limit/timeout failures (bot checks are never retried)
TRANSCRIPT_MAX_ATTEMPTS=2
TRANSCRIPT_RETRY_DELAY_MS=5000
# Deadline for one yt-dlp run
YTDLP_TIMEOUT_MS=90000
# Binary and JS runtime passed to `yt-dlp --js-runtimes` ("none" to omit the flag)
#YTDLP_PATH=yt-dlp
#YTDLP_JS_RUNTIME=node
# How long /health caches the OAuth refresh check
HEALTH_OAUTH_CACHE_MS=300000

# ---- docker compose (host side only) ----------------------------------------
# Publish the port on this host address only. Use the host's Tailscale IP
# (100.x.y.z) so n8n can reach it over the tailnet; 127.0.0.1 = local only.
BIND_ADDR=127.0.0.1
HOST_PORT=3000
# yt-dlp release baked into the image; bump + `docker compose build` to update
YTDLP_VERSION=2026.08.19
